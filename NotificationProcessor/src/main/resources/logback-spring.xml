<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Import your application.properties settings -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />
    <include resource="org/springframework/boot/logging/logback/file-appender.xml" />

    <!-- Pull the app name for Grafana filtering -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="unknown-service"/>

    <!-- Loki Configuration -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>app=${appName},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} - [%X{correlationId}] - (%logger{36}) - %-5level - %msg%n</pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="LOKI" />
    </root>
</configuration>