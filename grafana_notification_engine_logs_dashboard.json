{
  "__inputs": [
    { "name": "DS_LOKI", "label": "Loki", "description": "", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "13.1.1" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    { "id": 100, "type": "row", "title": "Real-Time Logs & Trace Search", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    { "id": 1, "type": "logs", "title": "Live Log Stream — paste a correlationId above to trace one transaction across every service",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "none",
        "sortOrder": "Descending", "enableInfiniteScrolling": true
      },
      "targets": [ { "expr": "{app=~\"$app\", level=~\"$level\"} |~ `$correlationId`", "refId": "A" } ]
    },

    { "id": 101, "type": "row", "title": "Log Volume & Levels", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "panels": [] },

    { "id": 2, "type": "timeseries", "title": "Log Volume by Level",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "ERROR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byRegexp", "options": "WARN" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byRegexp", "options": "INFO" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "expr": "sum by (level) (count_over_time({app=~\"$app\"}[$__interval]))", "legendFormat": "{{level}}", "refId": "A" } ]
    },

    { "id": 3, "type": "timeseries", "title": "Log Volume by Service",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "expr": "sum by (app) (count_over_time({app=~\"$app\", level=~\"$level\"}[$__interval]))", "legendFormat": "{{app}}", "refId": "A" } ]
    },

    { "id": 4, "type": "stat", "title": "Error Rate % (last 5m)",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background", "graphMode": "area" },
      "targets": [ { "expr": "100 * sum(count_over_time({app=~\"$app\", level=\"ERROR\"}[5m])) / sum(count_over_time({app=~\"$app\"}[5m]))", "refId": "A" } ]
    },

    { "id": 102, "type": "row", "title": "Error Aggregation & Deep Debugging", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "panels": [] },

    { "id": 5, "type": "table", "title": "Top Exceptions (last 1h)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 25 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "custom": { "align": "left" } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        { "expr": "topk(10, sum by (exception) (count_over_time({app=~\"$app\", level=\"ERROR\"} | regexp `(?P<exception>[A-Za-z0-9_.]+(?:Exception|Error))` [$__range])))",
          "queryType": "instant", "instant": true, "format": "table", "refId": "A" }
      ]
    },

    { "id": 6, "type": "timeseries", "title": "Resilience Events (Circuit Breaker Trips)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 25 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 30 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "expr": "sum by (app) (count_over_time({app=~\"$app\"} |= \"Circuit tripped\" [$__interval]))", "legendFormat": "{{app}}", "refId": "A" } ]
    },

    { "id": 7, "type": "timeseries", "title": "DLT Events (from CRITICAL AUDIT logs)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 30 } },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "expr": "sum by (app) (count_over_time({app=~\"$app\"} |= \"CRITICAL AUDIT\" [$__interval]))", "legendFormat": "{{app}}", "refId": "A" } ]
    },

    { "id": 103, "type": "row", "title": "Recent Errors & Warnings", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "panels": [] },

    { "id": 8, "type": "logs", "title": "Recent ERROR / WARN Logs — all services",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "none",
        "sortOrder": "Descending", "enableInfiniteScrolling": true
      },
      "targets": [ { "expr": "{app=~\"$app\", level=~\"ERROR|WARN\"} |~ `$correlationId`", "refId": "A" } ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["notification-engine", "logs", "loki"],
  "templating": {
    "list": [
      { "name": "DS_LOKI", "type": "datasource", "query": "loki", "current": {}, "hide": 0, "label": "Loki" },
      {
        "name": "app", "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(app)",
        "refresh": 2, "multi": true, "includeAll": true,
        "current": { "text": "All", "value": "$__all" }, "label": "Service"
      },
      {
        "name": "level", "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(level)",
        "refresh": 2, "multi": true, "includeAll": true,
        "current": { "text": "All", "value": "$__all" }, "label": "Level"
      },
      {
        "name": "correlationId", "type": "textbox",
        "label": "Trace: correlationId", "current": { "text": "", "value": "" }, "query": ""
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Notification Engine - Logs",
  "uid": "notif-engine-logs",
  "version": 1,
  "weekStart": ""
}