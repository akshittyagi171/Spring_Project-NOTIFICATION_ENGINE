{
  "name": "notification-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "root",
    "database.password": "root",
    "database.server.id": "1",
    "topic.prefix": "notification-engine",
    "database.include.list": "notification_engine",
    "table.include.list": "notification_engine.notifications",
    "schema.history.internal.kafka.bootstrap.servers": "broker:29092",
    "schema.history.internal.kafka.topic": "schema-changes.notification-engine",
    "producer.override.partitioner.class": "com.notificationengine.connect.PriorityPartitioner",
    "predicates": "isNotificationsData",
    "predicates.isNotificationsData.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isNotificationsData.pattern": "notification-engine\\.notification_engine\\.notifications",
    "transforms": "filterPopulated,route,fixPushTopic,prefixKey",
    "transforms.filterPopulated.type": "io.debezium.transforms.Filter",
    "transforms.filterPopulated.language": "jsr223.groovy",
    "transforms.filterPopulated.condition": "value.after != null && value.after.request_content != null",
    "transforms.filterPopulated.predicate": "isNotificationsData",
    "transforms.route.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.route.route.by.field": "channel",
    "transforms.route.table.field.event.id": "id",
    "transforms.route.table.field.event.key": "priority",
    "transforms.route.table.field.event.payload": "request_content",
    "transforms.route.table.fields.additional.placement": "correlation_id:header:correlationId",
    "transforms.route.route.topic.replacement": "${routedByValue}-topic",
    "transforms.route.predicate": "isNotificationsData",
    "transforms.fixPushTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.fixPushTopic.regex": "push-topic",
    "transforms.fixPushTopic.replacement": "push-n-topic",
    "transforms.prefixKey.type": "com.notificationengine.connect.PrefixKey"
  }
}